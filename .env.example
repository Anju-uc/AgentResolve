# ==============================================================================
# AgentResolve Configuration & Credentials File
# ==============================================================================
# Copy this file to .env and update the values as needed.
#
# NOTE: All core forensic engine calculations, rules, scoring, counterfactuals,
# and evaluation run 100% deterministically offline without any API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# [OPTIONAL] LLM API CREDENTIALS - HIGHLIGHTED FOR USER
# ------------------------------------------------------------------------------
# If set, the LLM module will use OpenAI or Gemini API to format natural language summaries.
# If omitted or left empty, the engine gracefully falls back to structured deterministic narratives.

# OpenAI API Key (Optional)
# OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Google Gemini API Key (Optional)
# GEMINI_API_KEY=AIzaSy-your-gemini-api-key-here

# Preferred LLM Provider: "openai", "gemini", or "mock" (Default: "mock")
LLM_PROVIDER=mock

# LLM Timeout in seconds
LLM_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
